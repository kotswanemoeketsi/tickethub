# Settings for docker-compose.yml. Everything is optional for trying GotATicket locally:
# copy this file to .env only to change something.

APP_NAME=GotATicket
WEB_PORT=8000
PUBLIC_URL=http://localhost:8000

# First super administrator, created on first start if none exists.
BOOTSTRAP_ADMIN_EMAIL=admin@gotaticket.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe2026

# Required for production (32+ characters each):  openssl rand -base64 48
JWT_SECRET=
QR_SIGNING_KEY=

MYSQL_PASSWORD=gotaticket
MYSQL_ROOT_PASSWORD=gotaticket-root
MYSQL_PORT=3307

# sandbox = built-in test gateway; ozow = live payments (required in production).
PAYMENT_PROVIDER=sandbox

# Sign in with Google: redirect URI <PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI features (smart search, "Write with AI", the event pre-check). They stay off until
# DEEPSEEK_API_KEY is set. Any OpenAI-compatible provider works, including a self-hosted
# DeepSeek model: point AI_BASE_URL at it and set the model names.
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_REVIEW_MODEL=deepseek-v4-pro
# Tokens per day across the platform before AI pauses until midnight (0 for no limit).
AI_DAILY_TOKEN_LIMIT=2000000

# Bank details shown for EFT payments.
EFT_ENABLED=true
EFT_BANK_NAME=First National Bank
EFT_ACCOUNT_NAME=GotATicket (Pty) Ltd
EFT_ACCOUNT_NUMBER=62000000000
EFT_BRANCH_CODE=250655

# Email. The defaults deliver everything to Mailpit at http://localhost:8025.
MAIL_FROM=GotATicket <no-reply@gotaticket.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=none
MAILPIT_PORT=8025

# Production behind HTTPS: APP_ENV=production, COOKIE_SECURE=true, TRUST_PROXY_HEADERS=true
APP_ENV=development
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# Ozow One API hosted checkout (see docs/OZOW.md). Server-side secrets only.
# Set PAYMENT_PROVIDER=ozow after credentials and the full webhook are configured.
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
OZOW_SITE_CODE=
OZOW_WEBHOOK_SECRET=
OZOW_BASE_URL=https://one.ozow.com/v1
