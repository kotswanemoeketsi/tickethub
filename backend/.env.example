# Local development settings for running the API natively (without Docker).
# Copy to backend/.env. Real environment variables always win over this file.

APP_ENV=development
APP_NAME=GotATicket
HTTP_ADDR=:8080
# Where people open the site (the Vite dev server) and where the API is reachable.
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:8080

DATABASE_DSN=gotaticket:gotaticket@tcp(127.0.0.1:3306)/gotaticket
AUTO_MIGRATE=true

# Optional. Leave empty to use an in-process cache (fine for one API process on a laptop).
REDIS_URL=

# Leave empty in development to use built-in throwaway secrets (a warning is logged).
# Production needs both, 32+ characters each:  openssl rand -base64 48
JWT_SECRET=
QR_SIGNING_KEY=

# 600000 is the production minimum. Lower values make sign-in faster on an old laptop.
PASSWORD_HASH_ITERATIONS=100000

# Sign in with Google (optional). Create an OAuth client in the Google Cloud console with
# the redirect URI http://localhost:5173/api/v1/auth/google/callback. See docs/DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI features (smart search, "Write with AI", the event pre-check). They stay off until
# DEEPSEEK_API_KEY is set. Any OpenAI-compatible provider works, including a self-hosted
# DeepSeek model: point AI_BASE_URL at it and set the model names.
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_REVIEW_MODEL=deepseek-v4-pro
# Tokens per day across the platform before AI pauses until midnight (0 for no limit).
AI_DAILY_TOKEN_LIMIT=2000000

# sandbox = built-in test gateway with its own checkout page. paystack = real payments.
PAYMENT_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=

EFT_ENABLED=true

# With no SMTP_HOST, emails (with PDF tickets attached) are written as .eml files here.
SMTP_HOST=
MAIL_DIR=./storage/mail
STORAGE_DIR=./storage/uploads

# Run the background worker inside the API process (simplest for development).
EMBEDDED_WORKER=true

LOG_LEVEL=info
